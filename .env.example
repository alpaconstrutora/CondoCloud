# ──────────────────────────────────────────────────────────────
# REDIS (Docker local)
# ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ──────────────────────────────────────────────────────────────
# STRIPE — Configurar na Fase 5
# ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ──────────────────────────────────────────────────────────────
# ASAAS — Boleto + PIX — Configurar na Fase 5
# ──────────────────────────────────────────────────────────────
ASAAS_API_KEY=
ASAAS_API_URL=https://sandbox.asaas.com/api/v3

# ──────────────────────────────────────────────────────────────
# EMAIL (Resend) — Configurar na Fase 5
# ──────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@condocloud.app

# ──────────────────────────────────────────────────────────────
# WHATSAPP (Meta Cloud API) — Configurar na Fase 5
# Obter em: https://developers.facebook.com → seu app → WhatsApp → Configuração
# ──────────────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=        # ID do número no Meta (ex: 123456789012345)
WHATSAPP_ACCESS_TOKEN=           # Token permanente gerado no Meta Business
WHATSAPP_WEBHOOK_VERIFY_TOKEN=   # String livre definida por você ao cadastrar o webhook na Meta

# ──────────────────────────────────────────────────────────────
# FIREBASE (FCM Push) — Configurar na Fase 5
# ──────────────────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ──────────────────────────────────────────────────────────────
# APP CONFIG
# ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Trial
TRIAL_DAYS=14
